# =============================================================================
# Digital Printing - EASM/DRPS Multi-Tenant Platform
# Copy to .env and adjust for your deployment
# =============================================================================

# ---- General ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=digital_printing
TZ=Europe/Paris
PUBLIC_HOSTNAME=easm.local

# ---- Orchestrator (FastAPI) ------------------------------------------------
ORCHESTRATOR_PORT=8080
ORCHESTRATOR_SECRET_KEY=change_me_to_a_long_random_string
ORCHESTRATOR_ADMIN_USER=admin
ORCHESTRATOR_ADMIN_PASSWORD=change_me_admin_password
ORCHESTRATOR_LOG_LEVEL=INFO

# ---- PostgreSQL (orchestrator state) --------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dp
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_DB=digital_printing

# ---- Redis (Celery broker + cache) ----------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- TheHive 5 -------------------------------------------------------------
THEHIVE_URL=http://thehive:9000
THEHIVE_API_KEY=change_me_thehive_apikey
THEHIVE_ORG=digital-printing
THEHIVE_SECRET=change_me_thehive_secret_key_must_be_at_least_64_chars_long_random

# ---- Cortex ----------------------------------------------------------------
CORTEX_URL=http://cortex:9001
CORTEX_API_KEY=change_me_cortex_apikey

# ---- MISP ------------------------------------------------------------------
MISP_URL=https://misp
MISP_API_KEY=change_me_misp_apikey
MISP_VERIFY_SSL=false
MISP_BASEURL=https://misp.local
MISP_MYSQL_PASSWORD=change_me_misp_mysql
MISP_ADMIN_EMAIL=admin@digital-printing.local
MISP_ADMIN_PASSPHRASE=change_me_misp_admin

# ---- SpiderFoot ------------------------------------------------------------
SPIDERFOOT_URL=http://spiderfoot:5001
SPIDERFOOT_USER=spiderfoot
SPIDERFOOT_PASSWORD=change_me_sf_password

# ---- AIL Framework ---------------------------------------------------------
AIL_URL=https://ail:7000
AIL_API_KEY=change_me_ail_apikey
AIL_VERIFY_SSL=false

# ---- LACUS (crawler) -------------------------------------------------------
LACUS_URL=http://lacus:7100
LACUS_TOR_PROXY=socks5://tor:9050

# ---- DRPS APIs (commercial, optional) -------------------------------------
INTELX_API_KEY=
INTELX_BASE_URL=https://2.intelx.io
DEHASHED_EMAIL=
DEHASHED_API_KEY=

# ---- Scanner tuning --------------------------------------------------------
NUCLEI_RATE_LIMIT=150
NUCLEI_TEMPLATES_PATH=/root/nuclei-templates
HTTPX_THREADS=50
NAABU_RATE=1000
KATANA_DEPTH=3
SPIDERFOOT_MAX_THREADS=10

# ---- Reporting -------------------------------------------------------------
REPORT_OUTPUT_DIR=/data/reports
REPORT_BRAND_NAME="Digital Printing MSSP"
REPORT_BRAND_LOGO=/app/reports/templates/logo.png
